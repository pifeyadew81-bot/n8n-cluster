# ==============================================================================
# n8n v3.x High-Availability Cluster Configuration
# ==============================================================================

# Database Settings
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_secure_pass_2026
POSTGRES_DB=n8n

# Security & Encryption (32-byte hex key)
N8N_ENCRYPTION_KEY=f8a7e4b9c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8
N8N_RUNNERS_AUTH_TOKEN=n8n_runner_secret_token_2026

# Host & Routing
N8N_HOST=n8n.dokploy.standartmaster.ru
WEBHOOK_URL=https://n8n.dokploy.standartmaster.ru/
N8N_EDITOR_BASE_URL=https://n8n.dokploy.standartmaster.ru/

# Timezone
GENERIC_TIMEZONE=Europe/Samara
TZ=Europe/Samara

# Queue & Runner Settings
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ClickHouse Network Access (from dashboard project)
# Hostname inside dokploy_net: dashboard-clickhouse
# Port: 8123 (HTTP) / 9000 (Native)
CLICKHOUSE_HOST=dashboard-clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=pyrus
CLICKHOUSE_USER=default
